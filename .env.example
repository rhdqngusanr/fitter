# Fitter 환경변수 예시
#
# 실제 값은 .env 에 넣는다. .env 는 gitignore 대상이다.
# 스키마와 기본값은 apps/api/src/config/env.ts 에서 zod로 검증한다.
# 부팅 시점에 검증하고 실패하면 즉시 죽는다.

# ─── 기본 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# ─── 데이터베이스 (필수) ────────────────────────────────
# docker compose up -d 로 띄운 로컬 DB 기준
DATABASE_URL=postgresql://fitter:fitter_dev_only@localhost:5432/fitter?schema=public

# ─── 인증 (필수) ────────────────────────────────────────
# 32자 이상. 운영 값은 배포 플랫폼의 시크릿으로 주입한다.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── 스토리지 (필수) ────────────────────────────────────
# 개발은 docker compose 의 MinIO, 운영은 Cloudflare R2.
# 둘 다 S3 API라 코드는 그대로이고 아래 값만 바뀐다.
# R2를 고른 이유는 egress가 무료라서다 — 이미지 서비스의 비용 급소다.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=fitter-images
STORAGE_ACCESS_KEY_ID=fitter
STORAGE_SECRET_ACCESS_KEY=fitter_dev_only
# R2는 지역 개념이 없어 auto 를 쓴다
STORAGE_REGION=auto

# ─── 큐 · Redis (필수) ──────────────────────────────────
# 썸네일 파생과 고아 파일 정리를 여기서 돌린다
REDIS_URL=redis://localhost:6379

# ─── 인증 (P4-1 이후 필수) ──────────────────────────────
# 절대 커밋하지 않는다. 운영 값은 배포 플랫폼의 시크릿으로 주입한다.
# JWT_SECRET=
