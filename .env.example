# Fitter 환경변수 예시
#
# 실제 값은 .env 에 넣는다. .env 는 gitignore 대상이다.
# 스키마와 기본값은 apps/api/src/config/env.ts 에서 zod로 검증한다.
# 부팅 시점에 검증하고 실패하면 즉시 죽는다.

# ─── 기본 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# ─── 데이터베이스 (필수) ────────────────────────────────
# docker compose up -d 로 띄운 로컬 DB 기준
DATABASE_URL=postgresql://fitter:fitter_dev_only@localhost:5432/fitter?schema=public

# ─── 인증 (필수) ────────────────────────────────────────
# 32자 이상. 운영 값은 배포 플랫폼의 시크릿으로 주입한다.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── 스토리지 (필수) ────────────────────────────────────
# 개발은 docker compose 의 MinIO, 운영은 Cloudflare R2.
# 둘 다 S3 API라 코드는 그대로이고 아래 값만 바뀐다.
# R2를 고른 이유는 egress가 무료라서다 — 이미지 서비스의 비용 급소다.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=fitter-images
STORAGE_ACCESS_KEY_ID=fitter
STORAGE_SECRET_ACCESS_KEY=fitter_dev_only
# R2는 지역 개념이 없어 auto 를 쓴다
STORAGE_REGION=auto

# ─── 큐 · Redis (필수) ──────────────────────────────────
# 썸네일 파생과 고아 파일 정리를 여기서 돌린다
REDIS_URL=redis://localhost:6379

# ─── 에러 트래킹 (선택) ─────────────────────────────────
# 비우면 Sentry를 아예 켜지 않는다. 로컬에서는 로그를 눈앞에서 보므로 비워도 된다.
# 배포된 서버는 아무도 로그를 안 보므로 거기서는 채운다.
SENTRY_DSN=

# ─── 웹 (apps/web) ──────────────────────────────────────
# NEXT_PUBLIC_ 접두사가 붙은 값은 **브라우저 번들에 그대로 박힌다.**
# 비밀을 여기 넣지 마라. 검증은 apps/web/src/lib/env.ts 한 곳에서 한다.
#
# 이미지 베이스는 스토리지의 공개 읽기 주소다. 목록에서 썸네일 N장을 띄울 때마다
# 서명 URL을 발급받으면 요청이 N배가 되므로, 공개 버킷 + 키 조합으로 URL을 만든다.
# 개발은 MinIO(익명 download 허용), 운영은 R2 공개 도메인이다.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:9000/fitter-images

# 브라우저에서 난 에러를 받는 주소. 비우면 끈다. 비밀이 아니다 — 이벤트를 보내는
# 주소일 뿐이고 이걸로 조회할 수 있는 건 없다.
NEXT_PUBLIC_SENTRY_DSN=

# 검색엔진 색인 허용 여부. **기본값은 차단이고 'true' 일 때만 열린다.**
# 반대로 만들면 환경변수를 빠뜨린 배포가 곧 색인 허용이 되는데, 잘못 걸린 색인은
# 검색엔진 캐시가 빠질 때까지 되돌릴 수 없다.
# 켜도 (app) 그룹과 로그인·가입은 계속 막힌다.
NEXT_PUBLIC_ALLOW_INDEXING=

# ─── 웹 빌드 시점 (선택, 배포 플랫폼에만) ───────────────
# 소스맵을 Sentry에 올려 압축된 스택을 원래 파일·줄로 풀어준다.
# 셋이 없으면 업로드를 건너뛰고 빌드는 그대로 성공한다. AUTH_TOKEN은 비밀이다.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
